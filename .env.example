# Application
APP_CONFIG=prod
SECRET_KEY=change-me-to-a-long-random-string
WTF_CSRF_SECRET_KEY=change-me-to-another-long-random-string
# Set to false if running without a TLS-terminating reverse proxy (nginx/caddy).
# Set to true once HTTPS is configured — Talisman will enforce HTTPS and HSTS.
TALISMAN_FORCE_HTTPS=false
# Domain authorized to embed the public map via iframe (e.g. your WordPress site).
# Leave empty to only allow embedding within the portal itself.
WORDPRESS_URL=https://votre-association.fr

# Database
# In production, add ?sslmode=require to enforce TLS on the connection:
# DATABASE_URL=postgresql://assoportail:password@host:5432/assoportail?sslmode=require
DATABASE_URL=postgresql://assoportail:password@localhost:5432/assoportail_dev

# Redis / Celery
# In docker-compose the URL is overridden to include the password automatically.
# For local dev without Docker, use: redis://localhost:6379/0
REDIS_URL=redis://:changeme@localhost:6379/0

# URL generation for Celery workers (workers run outside any HTTP request context)
# TASK_BASE_URL  — main portal origin, used for internal links (login, task detail…)
#                  e.g. https://portail.deslumieresdanslesyeux.fr
# LINKS_EXTERNAL_URL — public-facing origin for links sent to external users
#                      (feedback / livre d'or, signalement de panne, confirmation
#                       bénévole…). These forms may be served via a dedicated
#                       subdomain proxied by Nginx Proxy Manager.
#                      Falls back to TASK_BASE_URL when left empty.
#                  e.g. https://demande.deslumieresdanslesyeux.fr
TASK_BASE_URL=https://portail.deslumieresdanslesyeux.fr
LINKS_EXTERNAL_URL=https://demande.deslumieresdanslesyeux.fr

# Google OAuth2 (Gmail inbox + mailing + Google Drive)
# Upload credentials.json via the portal at /mailbox/ — no need to set these manually.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are read from the uploaded credentials.json.
GOOGLE_SHARED_DRIVE_ID=  # ID of the Workspace Shared Drive (from the Drive URL)

# OAuth token encryption (comma-separated Fernet keys — first is active, others for decryption during rotation)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=

# HelloAsso
HELLOASSO_API_TOKEN=
HELLOASSO_ORGANIZATION_SLUG=

# File storage
UPLOAD_FOLDER=/data/uploads
MAX_UPLOAD_PHOTO=10485760
MAX_UPLOAD_VIDEO=52428800
MAX_UPLOAD_DOCUMENT=20971520
# Tombola media videos (bureau-only upload): up to 1 GB by default.
MAX_UPLOAD_TOMBOLA_VIDEO=1073741824
# Flask rejects request bodies above this size with HTTP 413.
# Raised to 1 GB to allow tombola video uploads (bureau-only route).
# IMPORTANT: configure Nginx Proxy Manager to enforce a low body limit
# on public routes (/tombola/p/, /centers/feedback/, /machines/breakdown/)
# and the 1 GB limit only on /tombola/<id>/media.
# In NPM Advanced tab for the tombola media path:
#   client_max_body_size 1100m;
# For all other paths keep the global NPM default at 50m.
MAX_CONTENT_LENGTH=1073741824

# Mailing
MAILING_RATE_LIMIT=100          # emails per hour (0 = unlimited)
MAILING_BATCH_SIZE=10           # emails per task run before rescheduling
MAILING_POLL_INTERVAL=300

# SMTP (for sending account creation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@assoportail.fr
SMTP_USE_TLS=true

# Social Publishing — Facebook + Instagram (Meta)
# Create an app at https://developers.facebook.com — these never expire.
# Instagram uses the same credentials (linked via Meta Business Suite).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Social Publishing — LinkedIn
# Create an app at https://developer.linkedin.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Social Publishing — WordPress
# Credentials are managed via the portal UI (/social/accounts), not here.
# The bureau enters site_url + username + app_password in the admin interface.

# Social Publishing — image processing
SOCIAL_IMAGE_QUALITY=85
SOCIAL_MAX_IMAGES_PER_POST=10

# Web Push notifications (PWA)
# Generate with: flask vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PEM=
VAPID_CLAIMS_EMAIL=admin@votre-domaine.fr

# Initial admin account (created automatically on first run)
ADMIN_EMAIL=admin@assoportail.fr
ADMIN_PASSWORD=change-me-immediately

# PostgreSQL (used by docker-compose)
POSTGRES_USER=assoportail
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=assoportail_dev

# Redis authentication (used by docker-compose)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=changeme

# Exposed host ports (docker-compose only — change to avoid conflicts)
APP_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
